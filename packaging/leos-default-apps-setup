#!/usr/bin/bash
# Offer optional starter applications; never install or add a remote without consent.
set -euo pipefail

state_home="${XDG_STATE_HOME:-}"
if [[ -z "$state_home" || "$state_home" != /* ]]; then
    state_home="$HOME/.local/state"
fi
state_dir="$state_home/leos"
marker="$state_dir/default-apps-seeded"
# This consent applies only to the fixed v1 application list below. Increment the
# marker version whenever that list changes so new software always needs consent.
consent_marker="$state_dir/default-apps-consent-v1"

if [[ -L "$marker" || ( -e "$marker" && ! -f "$marker" ) ]]; then
    echo "LEOS: invalid starter-app state marker; refusing to continue." >&2
    exit 1
fi
if [[ -f "$marker" ]]; then
    exit 0
fi

apps=(
    com.brave.Browser
    org.libreoffice.LibreOffice
    org.videolan.VLC
)

if ! command -v flatpak >/dev/null 2>&1; then
    echo "Flatpak is not available yet." >&2
    exit 1
fi

if [[ -L "$consent_marker" || ( -e "$consent_marker" && ! -f "$consent_marker" ) ]]; then
    echo "LEOS: invalid starter-app consent marker; refusing to continue." >&2
    exit 1
fi

if [[ ! -f "$consent_marker" ]]; then
    # A graphical confirmation is mandatory. Headless sessions never install software.
    if ! command -v kdialog >/dev/null 2>&1; then
        echo "LEOS starter applications skipped: graphical confirmation is unavailable."
        exit 0
    fi

    if kdialog --title "Applications facultatives LEOS" --defaultno --yesno \
        "Souhaites-tu installer les applications facultatives suivantes dans ton profil utilisateur ?\\n\\n• Brave Browser\\n• LibreOffice\\n• VLC\\n\\nAucune application ne sera installée sans ton accord. Tu pourras ensuite les gérer depuis la boutique LEOS."; then
        :
    else
        dialog_status=$?
        if [[ "$dialog_status" -eq 1 ]]; then
            mkdir -p "$state_dir"
            touch "$marker"
            exit 0
        fi
        echo "LEOS: la fenêtre de consentement a échoué (code $dialog_status) ; aucune installation lancée." >&2
        exit 1
    fi

    # Persist approval before attempting any installation. A partial failure can
    # then be retried later without asking again or expanding the approved list.
    mkdir -p "$state_dir"
    if ! (umask 077; : > "$consent_marker"); then
        echo "LEOS: impossible d'enregistrer le consentement ; aucune installation lancée." >&2
        exit 1
    fi
fi

missing_apps=()

for app_id in "${apps[@]}"; do
    # Do not duplicate an application already present in either installation.
    if flatpak info --user "$app_id" >/dev/null 2>&1; then
        continue
    fi
    if flatpak info --system "$app_id" >/dev/null 2>&1; then
        continue
    fi
    missing_apps+=("$app_id")
done

if (( ${#missing_apps[@]} > 0 )); then
    remote_output="$(flatpak remotes --user --columns=name,url)"
    flathub_url="$(printf '%s\\n' "$remote_output" | awk 'tolower($1) == "flathub" { print $2; exit }')"

    if [[ -z "$flathub_url" ]]; then
        flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
        remote_output="$(flatpak remotes --user --columns=name,url)"
        flathub_url="$(printf '%s\\n' "$remote_output" | awk 'tolower($1) == "flathub" { print $2; exit }')"
    fi

    case "$flathub_url" in
        https://dl.flathub.org/repo/|https://flathub.org/repo/|\\
        https://dl.flathub.org/repo/flathub.flatpakrepo|https://flathub.org/repo/flathub.flatpakrepo)
            ;;
        *)
            echo "LEOS: le dépôt nommé Flathub est absent ou son URL n'est pas officielle ; aucune installation lancée." >&2
            exit 1
            ;;
    esac

    failed=0
    for app_id in "${missing_apps[@]}"; do
        if ! flatpak install --user --noninteractive --or-update flathub "$app_id"; then
            echo "LEOS: installation facultative échouée pour $app_id ; une nouvelle tentative sera proposée." >&2
            failed=1
        fi
    done

    if (( failed != 0 )); then
        exit 1
    fi
fi

mkdir -p "$state_dir"
touch "$marker"
rm -f "$consent_marker"
