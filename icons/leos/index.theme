Context=Applications
Type=Scalable
MinSize=16
MaxSize=256
Threshold=0

[scalable/devices]
Size=48
Context=Devices
Type=Scalable
MinSize=16
MaxSize=256
Threshold=0

[scalable/status]
Size=48
