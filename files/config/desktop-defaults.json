{
  "schema_version": 1,
  "product": "LEOS",
  "mode": "desktop",
  "theme": "leos-original",
  "appearance": {
    "color_scheme": "dark",
    "background": "#0D0D0D",
    "surface": "#171717",
    "surface_elevated": "#242424",
    "border": "#3A3A3A",
    "text": "#F1F1F1",
    "muted_text": "#A5A5A5",
    "accent_primary": "#A0A0A0",
    "accent_secondary": "#D0D0D0",
    "corner_radius": 12,
    "animations_enabled": true
  },
  "desktop": {
    "show_desktop_icons": false,
    "dock": {
      "enabled": true,
      "position": "bottom",
      "alignment": "center",
      "auto_hide": false,
      "pinned_applications": [
        "org.mozilla.firefox",
        "com.brave.Browser",
        "steam",
        "org.kde.dolphin",
        "org.kde.systemsettings"
      ]
    },
    "widgets": {
      "enabled_by_default": false,
      "user_can_add": true
    }
  },
  "safety": {
    "apply_to_existing_user_profile_automatically": false,
    "preserve_existing_kde_configuration": true,
    "allow_user_customization": true
  }
}
