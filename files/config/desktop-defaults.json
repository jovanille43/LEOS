{
  "schema_version": 1,
  "product": "LEOS",
  "mode": "desktop",
  "theme": "leos-original",
  "appearance": {
    "color_scheme": "dark",
    "background": "#0B0B0B",
    "surface": "#151515",
    "surface_elevated": "#202020",
    "border": "#3A3A3A",
    "text": "#F5F5F5",
    "muted_text": "#A6A6A6",
    "accent_primary": "#A0A0A0",
    "accent_secondary": "#D0D0D0",
    "corner_radius": 12,
    "animations_enabled": true
  },
  "desktop": {
    "show_desktop_icons": false,
    "dock": {
      "enabled": true,
      "position": "bottom",
      "alignment": "center",
      "auto_hide": false,
      "pinned_applications": [
        "leos-menu.desktop",
        "leos-mode-selector.desktop",
        "org.kde.dolphin.desktop",
        "firefox.desktop",
        "steam.desktop",
        "leos-control-center.desktop"
      ]
    },
    "widgets": {
      "enabled_by_default": false,
      "user_can_add": true
    }
  },
  "safety": {
    "apply_to_existing_user_profile_automatically": false,
    "preserve_existing_kde_configuration": true,
    "allow_user_customization": true
  }
}
